;; Keyboard: MacBook Air / Pro · US
;; main
;; Built with Kanata Studio

(defcfg
  process-unmapped-keys yes
  macos-dev-names-include ("Apple Internal Keyboard / Trackpad")
)

(defsrc
  esc f1 f2 f3 f4 f5 f6 f7 f8 f9 f10 f11 f12
  grv 1 2 3 4 5 6 7 8 9 0 - = bspc
  tab q w e r t y u i o p [ ] bksl
  caps a s d f g h j k l ; ' ret
  lsft z x c v b n m , . / rsft
  fn lctl lalt lmet spc rmet ralt left up down rght
)

(deflayer base
  esc f1 f2 f3 f4 f5 f6 f7 f8 f9 f10 f11 f12
  grv 1 2 3 4 5 6 7 8 9 0 - = bspc
  tab q w e r t y u i o p [ ] bksl
  (tap-hold 200 200 esc lctl) (tap-hold 200 200 a lctl) s d f g h j k l (tap-hold 200 200 ret lctl) ' ret
  lsft z x c v b n m , . / rsft
  fn lctl lalt (tap-hold 200 200 bspc lmet) spc rmet ralt left up down rght
)

(deflayer bra
  _ _ _ _ _ _ _ _ _ _ _ _ _
  _ _ _ _ _ _ _ _ _ _ _ _ _ _
  _ _ _ _ _ _ _ _ _ _ _ _ _ _
  _ _ _ _ _ _ _ _ _ _ _ _ _
  _ _ _ _ _ _ _ _ _ _ _ _
  _ _ _ _ _ _ _ _ _ _ _
)
