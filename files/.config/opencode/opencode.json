{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "@playwright/mcp@latest",
        "--extension",
        "--profile-dir-name",
        "playwright"
      ],
      "enabled": true
    },
    "officecli": {
      "type": "local",
      "command": ["officecli", "mcp"],
      "enabled": true
    }
  },
  "model": "openai/gpt-6.1-sol",
  "default_agent": "build",
  "agent": {
    "build": {
      "disable": false
    },
    "plan": {
      "disable": false
    }
  },
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "ministral-3:3b": {
          "name": "ministral-3:3b"
        }
      }
    }
  }
}
