{ // ------------------------------------ neovim ------------------------------------
    "editor.lineNumbers": "relative",
    // https://github.com/vscode-neovim/vscode-neovim/issues/1051
    "extensions.experimental.affinity": {
        "asvetliakov.vscode-neovim": 1
    },
    "editor.accessibilitySupport": "on",
    "vscode-neovim.neovimInitVimPaths.darwin": "/Users/ryu/.config/nvim/src/lua/vscode/init.lua",
    "vscode-neovim.compositeKeys": {
        "jj": {
            "command": "vscode-neovim.escape",
        },
    },
    "editor.formatOnSave": true,
    // https://github.com/vscode-neovim/vscode-neovim/issues/2099#issuecomment-2657736422
    "workbench.view.showQuietly": {
        "workbench.panel.output": true
    },
    // -----------------------------------------------------------------------------
    "github.copilot.nextEditSuggestions.enabled": true,
    // signals (bothering sounds)
    "accessibility.signals.chatRequestSent": {
        "sound": "off",
        "announcement": "off"
    },
    "accessibility.signals.chatResponseReceived": {
        "sound": "off"
    },
    "accessibility.signals.chatUserActionRequired": {
        "sound": "off",
        "announcement": "off"
    },
    "accessibility.signals.clear": {
        "sound": "off",
        "announcement": "off"
    },
    "accessibility.signals.codeActionApplied": {
        "sound": "off"
    },
    "accessibility.signals.codeActionTriggered": {
        "sound": "off"
    },
    "accessibility.signals.diffLineDeleted": {
        "sound": "off"
    },
    "accessibility.signals.progress": {
        "sound": "off"
    },
    "accessibility.signals.editsUndone": {
        "sound": "off",
        "announcement": "off"
    },
    "accessibility.signals.positionHasWarning": {
        "sound": "off",
        "announcement": "off"
    },
    "accessibility.signals.positionHasError": {
        "sound": "off",
        "announcement": "off"
    },
    "accessibility.signals.noInlayHints": {
        "sound": "off",
        "announcement": "off"
    },
    "accessibility.signals.nextEditSuggestion": {
        "sound": "off",
        "announcement": "off"
    },
    "accessibility.signals.lineHasWarning": {
        "sound": "off",
        "announcement": "off"
    },
    "accessibility.signals.lineHasInlineSuggestion": {
        "sound": "off"
    },
    "accessibility.signals.lineHasFoldedArea": {
        "sound": "off"
    },
    "accessibility.signals.lineHasError": {
        "sound": "off"
    },
    "accessibility.signals.lineHasBreakpoint": {
        "sound": "off",
        "announcement": "off"
    },
    // editor tab settings
    "editor.minimap.enabled": false,
    "workbench.editor.enablePreviewFromCodeNavigation": true,
    "workbench.editor.enablePreviewFromQuickOpen": true,
    "workbench.editor.limit.enabled": true,
    "workbench.editor.limit.perEditorGroup": true,
    "workbench.editor.limit.value": 1,
    "workbench.editor.mouseBackForwardToNavigate": false,
    "workbench.editor.openPositioning": "left",
    "workbench.editor.splitInGroupLayout": "vertical",
}